# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# === Sarvam AI ===
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_LLM_MODEL=sarvam-m

# === Extractor LLM (mock by default; swap provider by setting EXTRACTOR_PROVIDER) ===
EXTRACTOR_PROVIDER=mock         # mock | grok | openai | anthropic | sarvam
GROK_API_KEY=your_grok_api_key
GROK_MODEL=grok-2-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === IVR adapter (mock by default; twilio|exotel when ready) ===
IVR_PROVIDER=mock               # mock | twilio | exotel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

# === WhatsApp adapter ===
WHATSAPP_PROVIDER=mock          # mock | meta
META_WABA_PHONE_ID=
META_WABA_TOKEN=

# === SMS provider ===
SMS_PROVIDER=mock

# === App ===
APP_ENV=dev
LOG_LEVEL=INFO
INTERVIEW_MAX_TURNS=8
INTERVIEW_STABLE_TURNS=2
# ================================================================
#  Haqdaar.ai: environment template
#  Copy to .env and fill in. Every value here is a placeholder.
#  apps/api reads this file; apps/api/.env (optional) overrides it.
# ================================================================

# === Database (PostgreSQL 16, UTF-8) ===
# Local Docker (docker compose up -d):
HAQDAAR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haqdaar
# Supabase works too: use the session pooler URL (port 6543), with the
# password URL-encoded (@ -> %40, : -> %3A, / -> %2F).

# === API ===
API_PORT=4000
# Browser origins allowed to call the API (the citizen site and the console)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Curator console ===
# The code curators type to sign in. Pick a long random value.
ADMIN_ACCESS_CODE=change-me

# === Speech-to-text: Sarvam AI (voice input, FR-02) ===
# Leave empty to disable voice; the typed form always works.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# The phone-call demo's voice (text-to-speech). Without a key the browser's own voice reads.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=1.1
SARVAM_TTS_TEMPERATURE=0.6

# === Phone line: Exotel Voicebot applet -> wss://<public host>/exotel/voicebot ===
# Shared secret; set the same value as the applet's custom parameter "token".
EXOTEL_STREAM_TOKEN=
# Must match the applet's sample rate (8000, 16000 or 24000).
EXOTEL_SAMPLE_RATE=16000

# === Field extraction: Groq-hosted Llama 3 (FR-03) ===
# Free key: https://console.groq.com/keys. Without it, free text and transcripts
# are parsed by deterministic keyword rules instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === myscheme.gov.in scraper (FR-07, NFR-07) ===
# The public API key is discovered from the site's own JS bundle; set this only
# if discovery ever breaks.
MYSCHEME_API_KEY=
# Politeness: minimum gap between requests (ms) and parallel detail fetches.
MYSCHEME_MIN_INTERVAL_MS=350
MYSCHEME_CONCURRENCY=3
# MYSCHEME_CACHE_DIR=data/myscheme/raw

# === One-click launcher (scripts/dev/run.bat) ===
# Local PostgreSQL install to start if port 5433 is free (folder with bin\pg_ctl.exe).
HAQDAAR_PG_DIR=
# Your Exotel flow editor page, opened after the tunnel starts so its URL can be pasted.
EXOTEL_FLOW_EDIT_URL=
# Account ID sent by Exotel with each call; only that account may use the phone line.
EXOTEL_ACCOUNT_SID=
# PIN callers key in before the language menu on the phone line (empty = no PIN)
EXOTEL_CALL_PIN=
